#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

/* Digits 0-9 and =/-/+ combos use COMBO_TYPING_PRIOR_IDLE_MS. */

#define COMBO_TYPING_PRIOR_IDLE_MS 50

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&sk {
    release-after-ms = <1500>;
    quick-release;
};

&mmv {
    time-to-max-speed-ms = <2>;
    acceleration-exponent = <3>;
};

&msc {
    delay-ms = <0>;
    acceleration-exponent = <3>;
    time-to-max-speed-ms = <1>;
};

&sl { release-after-ms = <1500>; };

/ {
    chosen { zmk,physical-layout = &foostan_corne_5col_layout; };
};

/ {
    macros {
        mac_lgui_tab: mac_lgui_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "MAC_LGUI_TAB";
        };

        mac_change_language: mac_change_language {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPC)>;
            label = "MAC_CHANGE_LANGUAGE";
        };

        macro_open_clipboard: macro_open_clipboard {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LGUI>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LCTRL &kp LGUI>;

            label = "MACRO_OPEN_CLIPBOARD";
        };

        single_tap: single_tap {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_wait_time 200>;

            label = "SINGLE_TAP";
        };

        mm_shift_capsword: mm_shift_capsword {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SHIFT_CAPSWORD";
            bindings =
                <&ht_sk_shift_capsword LEFT_SHIFT LEFT_SHIFT>,
                <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        macro_hyperkey: macro_hyperkey {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LS(LA(LC(LG(LGUI)))) &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LS(LA(LC(LG(LGUI))))>;

            label = "MACRO_HYPERKEY";
        };

        macro_tap_and_navword: macro_tap_and_navword {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;

            /* nav_word_simple has #binding-cells = <0> — no MACRO_PLACEHOLDER on it */

            bindings =
                <&macro_release>,
                <&nav_word_simple>,
                <&macro_press>,
                <&nav_word_simple>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "MACRO_TAP_AND_NAVWORD";
        };

        macro_mo_default_on_release: macro_default_on_release {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to 0>;

            label = "MACRO_DEFAULT_ON_RELEASE";
        };
    };

    combos {
        compatible = "zmk,combos";

        mac_screenshot_clipboard {
            bindings = <&kp LS(LC(LG(NUMBER_4)))>;
            key-positions = <1 2 3>;
        };

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <12 13>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        mac_screenshot_image {
            bindings = <&kp LS(LG(NUMBER_4))>;
            key-positions = <2 3 4>;
        };

        tab_combo {
            bindings = <&kp TAB>;
            key-positions = <13 23>;
        };

        combo_tab_shift {
            bindings = <&kp LS(TAB)>;
            key-positions = <16 26>;
        };

        combo_zero {
            bindings = <&kp KP_NUMBER_0>;
            key-positions = <14 4 24>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_one {
            bindings = <&long_combo_th EXCL NUMBER_1>;
            key-positions = <13 3 23>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_two {
            bindings = <&long_combo_th AT_SIGN NUMBER_2>;
            key-positions = <12 2 22>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_three {
            bindings = <&long_combo_th HASH NUMBER_3>;
            key-positions = <11 1 21>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_four {
            bindings = <&long_combo_th DOLLAR NUMBER_4>;
            key-positions = <10 0 20>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_five {
            bindings = <&long_combo_th PERCENT KP_NUMBER_5>;
            key-positions = <15 5 25>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_six {
            bindings = <&long_combo_th CARET KP_NUMBER_6>;
            key-positions = <16 6 26>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_seven {
            bindings = <&long_combo_th AMPERSAND KP_N7>;
            key-positions = <17 7 27>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_eight {
            bindings = <&kp KP_NUMBER_8>;
            key-positions = <18 8 28>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_nine {
            bindings = <&kp KP_NUMBER_9>;
            key-positions = <19 9 29>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <17 7 27>;
            layers = <1>;
        };

        combo_caret {
            bindings = <&kp CARET>;
            key-positions = <16 6 26>;
            layers = <1>;
        };

        combo_percent {
            bindings = <&kp PERCENT>;
            key-positions = <15 5 25>;
            layers = <1>;
        };

        combo_five_hand {
            bindings = <&kp KP_NUMBER_5>;
            key-positions = <14 4 24>;
            layers = <1>;
        };

        combo_six_hand {
            bindings = <&kp KP_N6>;
            key-positions = <13 3 23>;
            layers = <1>;
        };

        combo_seven_hand {
            bindings = <&kp KP_NUMBER_7>;
            key-positions = <2 12 22>;
            layers = <1>;
        };

        combo_eight_hand {
            bindings = <&kp KP_N8>;
            key-positions = <11 1>;
            layers = <1>;
        };

        combo_nine_hand {
            bindings = <&kp N9>;
            key-positions = <10 0>;
            layers = <1>;
        };

        lalt_lshift_combo {
            bindings = <&kp LS(LALT)>;
            key-positions = <13 11>;
        };

        lctrl_lshift_combo {
            bindings = <&kp LS(LCTRL)>;
            key-positions = <13 10>;
        };

        lgui_lcombo_r_combo {
            bindings = <&kp LS(LGUI)>;
            key-positions = <26 27 25 28 29>;
        };

        lalt_lshift_r_combo {
            bindings = <&kp LS(LALT)>;
            key-positions = <26 28>;
        };

        lctrl_lshift_r_combo {
            bindings = <&kp LS(LCTRL)>;
            key-positions = <26 29>;
        };

        combo_plus {
            bindings = <&kp PLUS>;
            key-positions = <23 22>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_equals {
            bindings = <&kp EQUAL>;
            key-positions = <23 24>;
            require-prior-idle-ms = <COMBO_TYPING_PRIOR_IDLE_MS>;
        };

        combo_underscore {
            bindings = <&kp UNDER>;
            key-positions = <17 16>;
        };

        combo_bt_select_1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <6 8 7>;
        };

        combo_bt_select_2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <16 17 18>;
        };

        combo_blue_layer {
            bindings = <&mo 5>;
            key-positions = <9 29>;
        };

        combo-left-par {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <14 4>;
        };

        combo_right_par {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <15 5>;
        };

        combo_grave {
            bindings = <&ht_single_tap TILDE GRAVE>;
            key-positions = <3 13>;
        };

        combo_at {
            bindings = <&kp AT_SIGN>;
            key-positions = <12 11>;
        };

        combo_hash {
            bindings = <&kp HASH>;
            key-positions = <10 0>;
        };

        combo_dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <14 24>;
        };

        combo_clipbaord {
            bindings = <&macro_open_clipboard>;
            key-positions = <1 3>;
        };

        combo_left_bracket {
            bindings = <&ht_single_tap LEFT_BRACE LEFT_BRACKET>;
            key-positions = <12 2>;
        };

        combo_right_bracket {
            bindings = <&ht_single_tap RIGHT_BRACE RIGHT_BRACKET>;
            key-positions = <17 7>;
        };

        combo_left_parenth {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <11 1>;
        };

        combo_right_parenth {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 8>;
        };

        combo_backslash {
            bindings = <&ht_single_tap PIPE BACKSLASH>;
            key-positions = <16 6>;
        };

        combo_excl_mark {
            bindings = <&kp EXCL>;
            key-positions = <17 18>;
        };

        combo_asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <26 27>;
        };

        combo_amp {
            bindings = <&kp AMPS>;
            key-positions = <25 26>;
        };

        combo_excl_2 {
            bindings = <&kp EXCL>;
            key-positions = <13 2>;
        };

        combo_question {
            bindings = <&kp QUESTION>;
            key-positions = <7 16>;
        };
    };

    behaviors {
        long_mo_tp: long_mo_tp {
            compatible = "zmk,behavior-hold-tap";
            label = "LONG_MO_TP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            require-prior-idle-ms = <300>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
        };

        long_th_kp: long_th_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "LONG_TH_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            require-prior-idle-ms = <300>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
        };

        nav_word_simple: nav_word_simple {
            #binding-cells = <0>;
            compatible = "zmk,behavior-num-word";
            layers = <2>;   /* HYPER_TAP */
            continue-list = <LEFT DOWN UP RIGHT LSHIFT LGUI LALT LCTRL ENTER J K Z HOME END PG_DN PG_UP>;
            ignore-numbers;
        };

        tab_swap: tab_swap {
            compatible = "zmk,behavior-tri-state";
            label = "TAB_SWAPPER";
            #binding-cells = <0>;
            bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;

            ignored-key-positions = <43>;
        };

        grave_swap: grave_swap {
            compatible = "zmk,behavior-tri-state";
            label = "GRAVE_SWAPPER";
            #binding-cells = <0>;
            bindings = <&kt LGUI>, <&kp GRAVE>, <&kt LGUI>;

            ignored-key-positions = <43>;
        };

        grave_swap_shift: grave_swap_shift {
            compatible = "zmk,behavior-tri-state";
            label = "GRAVE_SWAP_SHIFT";
            #binding-cells = <0>;
            bindings = <&kt LGUI>, <&kp LS(GRAVE)>, <&kt LGUI>;

            ignored-key-positions = <43>;
        };

        ht_single_tap: ht_single_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SINGLE_TAP";
            bindings = <&single_tap>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            flavor = "tap-preferred";
        };

        ht_maclanguage_r: ht_maclanguage_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_MACLANGUAGE_R";
            bindings = <&mac_change_language>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "tap-preferred";
        };

        ht_sk_shift_capsword: ht_sk_shift_capsword {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SK_SHIFT_CAPSWORD";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <1 2 3 4 5 15 16 17 18 19 29 30 31 32 33>;
        };

        ht_single_tap_weak: ht_single_tap_weak {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SINGLE_TAP_WEAK";
            bindings = <&single_tap>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <275>;
            flavor = "tap-preferred";
        };

        long_combo_th: long_combo_th {
            compatible = "zmk,behavior-hold-tap";
            label = "LONG_COMBO_TH";
            bindings = <&single_tap>, <&kp>;

            #binding-cells = <2>;
            require-prior-idle-ms = <0>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
        };

        semi_long_th_kp: semi_long_th_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "SEMI_LONG_TH_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            require-prior-idle-ms = <150>;
            tapping-term-ms = <175>;
            flavor = "tap-preferred";
        };

        ht_single_tap_semi_weak: ht_single_tap_semi_weak {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SINGLE_TAP_SEMI_WEAK";
            bindings = <&single_tap>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        mo_sl_trigger: mo_sl_trigger {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&macro_mo_default_on_release>, <&sl>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            hold-trigger-key-positions = <6 7 8 5 14 13 4 3 2 12 11 1 0 10 24 21 22 23 20>;
            hold-while-undecided;
        };

        /* Shift + Esc tap: app switcher; else Esc hold-tap (NAV + Esc). Space has no morph. */

        esc_shift_lgui_tab_mm: esc_shift_lgui_tab_mm {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC_SHIFT_LGUI_TAB_MM";
            bindings = <&short_mo_tp_esc 4 ESCAPE>, <&mac_lgui_tab>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        short_mo_tp_space_hold_pref: short_mo_tp_space_hold_pref {
            compatible = "zmk,behavior-hold-tap";
            label = "SHORT_MO_TP_SPACE_HOLD_PREF";
            bindings = <&macro_mo_default_on_release>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <140>;
            flavor = "hold-preferred";
            hold-trigger-key-positions = <34 35 15 16 17 18 5 6 7 8 9 19 29 28 27 26 25 33 13 12 2 3 11 10>;
            hold-while-undecided;
        };

        short_mo_tp_esc: short_mo_tp_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "SHORT_MO_TP_ESC";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <15 16 17 18 26 27 5 6 9 8 7 19 29 28 25 34 35 33>;
            hold-while-undecided;
        };

        mo_sl_hyper: mo_sl_hyper {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&macro_mo_default_on_release>, <&sl>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            hold-while-undecided;
            label = "MO_SL_HYPER";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";
            bindings = <
  &kp Q                           &kp W                            &kp E                               &ht_maclanguage_r 0 R          &long_mo_tp 6 T                  &kp Y                   &kp U                 &kp I                               &kp O                      &kp P
  &semi_long_th_kp LCTRL A        &semi_long_th_kp LALT S          &semi_long_th_kp LGUI D             &semi_long_th_kp LEFT_SHIFT F  &semi_long_th_kp LS(LGUI) G      &kp H                   &kp J                 &kp K                               &kp L                      &short_mo_tp_space_hold_pref 2 COLON
  &ht_single_tap_weak QUESTION Z  &ht_single_tap_weak LESS_THAN X  &ht_single_tap_weak GREATER_THAN C  &long_th_kp LS(LC(LALT)) V     &kp B                            &long_th_kp LS(LGUI) N  &long_th_kp LSHIFT M  &long_th_kp RIGHT_GUI COMMA         &long_th_kp RIGHT_ALT DOT  &long_th_kp RIGHT_CONTROL FSLH
                                                                   &esc_shift_lgui_tab_mm              &kp SPACE                      &mo_sl_hyper 1 1                 &mm_shift_capsword      &mo_sl_trigger 3 3    &long_th_kp LS(LEFT_CONTROL) ENTER
            >;
        };

        NAV {
            bindings = <
  &ht_single_tap TILDE GRAVE  &kp LG(X)      &grave_swap_shift  &grave_swap     &tab_swap                           &kp LA(LEFT)       &kp LA(LS(LEFT))    &kp LS(LA(RIGHT))  &kp LA(RIGHT)   &kp SEMICOLON
  &kp LCTRL                   &kp LALT       &kp LGUI           &kp LEFT_SHIFT  &ht_single_tap LG(ENTER) ENTER      &kp LEFT_ARROW     &kp DOWN            &kp UP_ARROW       &kp RIGHT       &kp APOSTROPHE
  &kp LG(Z)                   &kp LG(LS(Z))  &kp LG(C)          &kp LG(V)       &kp BACKSPACE                       &kp LA(BACKSPACE)  &kp BACKSPACE       &kp DELETE         &kp LA(DELETE)  &single_tap DOUBLE_QUOTES
                                             &trans             &trans          &trans                              &trans             &mo_sl_trigger 3 3  &kp LS(ENTER)
            >;

            label = "NAV";
        };

        HYPER {
            label = "HYPER";
            bindings = <
  &macro_hyperkey Q  &macro_hyperkey W  &macro_hyperkey E  &macro_hyperkey R  &kp LG(TAB)            &trans  &trans  &trans  &trans  &trans
  &macro_hyperkey A  &macro_hyperkey S  &macro_hyperkey D  &macro_hyperkey F  &macro_hyperkey G      &trans  &trans  &trans  &trans  &trans
  &trans             &trans             &trans             &trans             &trans                 &trans  &trans  &trans  &trans  &trans
                                        &trans             &trans             &trans                 &trans  &trans  &trans
            >;
        };

        NUM {
            display-name = "NUM";
            bindings = <
  &kp N9                                    &ht_single_tap ASTERISK N8              &ht_single_tap_semi_weak AMPS N7      &ht_single_tap_semi_weak CARET NUMBER_6  &ht_single_tap_semi_weak PERCENT N5      &trans    &msc SCRL_DOWN  &msc SCRL_UP  &trans    &trans
  &ht_single_tap_semi_weak DOLLAR NUMBER_4  &ht_single_tap_semi_weak HASH NUMBER_3  &ht_single_tap_semi_weak AT NUMBER_2  &ht_single_tap_semi_weak EXCL NUMBER_1   &kp N0                                   &mkp MB4  &kp LC(D)       &kp LC(U)     &mkp MB5  &trans
  &kp QUESTION                              &trans                                  &trans                                &trans                                   &trans                                   &trans    &trans          &trans        &trans    &trans
                                                                                    &trans                                &trans                                   &trans                                   &trans    &trans          &trans
            >;
        };

        FUNC {
            display-name = "FUNC";
            bindings = <
  &kp F9  &kp F8  &kp F7   &kp F6   &kp F5       &kp LC(LEFT)                               &kp LC(DOWN)                               &kp LC(UP)                                         &kp LC(RIGHT)                                &trans
  &kp F4  &kp F3  &kp F2   &kp F1   &kp F10      &ht_single_tap_weak LG(LS(LEFT)) LG(LEFT)  &ht_single_tap_weak LS(LG(DOWN)) LG(DOWN)  &ht_single_tap_weak LS(LG(UP_ARROW)) LG(UP_ARROW)  &ht_single_tap_weak LS(LG(RIGHT)) LG(RIGHT)  &trans
  &trans  &trans  &kp F12  &kp F11  &trans       &kp LS(LC(LEFT))                           &kp LS(LC(DOWN))                           &kp LS(LC(UP))                                     &kp LC(LS(RIGHT))                            &trans
                  &trans   &trans   &trans       &trans                                     &trans                                     &trans
            >;
        };

        BLUE {
            bindings = <
  &bt BT_CLR     &bt BT_CLR_ALL  &trans         &bootloader    &sys_reset        &trans  &trans  &trans  &trans  &trans
  &bt BT_DISC 4  &bt BT_DISC 3   &bt BT_DISC 2  &bt BT_DISC 1  &out OUT_USB      &trans  &trans  &trans  &trans  &trans
  &bt BT_SEL 4   &bt BT_SEL 3    &bt BT_SEL 2   &bt BT_SEL 1   &out OUT_BLE      &trans  &trans  &trans  &trans  &trans
                                 &trans         &trans         &trans            &trans  &trans  &trans
            >;

            label = "BLUE";
        };

        MEDIA {
            bindings = <
  &trans  &trans  &trans  &trans  &trans      &kp C_PREVIOUS  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_NEXT          &trans
  &trans  &trans  &trans  &trans  &trans      &kp C_REWIND    &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_FAST_FORWARD  &trans
  &trans  &trans  &trans  &trans  &trans      &trans          &kp C_PP              &trans                &trans              &trans
                  &trans  &trans  &trans      &trans          &trans                &trans
            >;

            label = "MEDIA";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
